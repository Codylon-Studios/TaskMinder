{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "typeRoots": ["../node_modules/@types"],
    "moduleResolution": "bundler",
    "allowJs": true,
    "types": ["node", "jquery", "bootstrap"]
  },
  "include": ["src/**/*"],
  "exclude": ["src/sw.ts"]
}
