server {
    listen 80;
    server_name _;

    server_tokens off;
    client_max_body_size 20m;


    error_page 413 = @payload_too_large;

    location @payload_too_large {
        default_type text/plain;
        return 413 "NGINX request size limit exceeded";
    }


    location = /bootstrap {
        access_by_lua_block {
		    local flag_cache = ngx.shared.maintenance_flag
		    local is_maintenance = flag_cache:get("active")

		    if is_maintenance == nil then
                local f = io.open("/etc/nginx/maintenance.flag", "r")
                is_maintenance = (f ~= nil)
                if f then f:close() end
                flag_cache:set("active", is_maintenance, 5)
		    end

		    if is_maintenance then
                local cjson = require "cjson"
                ngx.header["X-Maintenance-Mode"] = "1"
                ngx.header["Cache-Control"]       = "no-store"
                ngx.header["Retry-After"]         = "600"
                ngx.status = 503

                local fh = io.open("/opt/TaskMinder/maintenance.html", "r")
                if fh then
                    local body = fh:read("*a")
                    fh:close()
                    ngx.header["Content-Type"] = "application/json; charset=utf-8"
                    local data = {
                        maintenance = true,
                        maintenanceHtml = body
                    }
                    ngx.print(cjson.encode(data))
                else
                    ngx.header["Content-Type"] = "text/plain"
                    ngx.print("Service Unavailable")
                end
			    ngx.exit(ngx.HTTP_OK)
		    end
        }

        proxy_pass http://localhost:3000;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 120;
    }

    location / {
        access_by_lua_block {
		    local flag_cache = ngx.shared.maintenance_flag
		    local is_maintenance = flag_cache:get("active")

		    if is_maintenance == nil then
                local f = io.open("/etc/nginx/maintenance.flag", "r")
                is_maintenance = (f ~= nil)
                if f then f:close() end
                flag_cache:set("active", is_maintenance, 5)
		    end

		    if is_maintenance then
                ngx.header["X-Maintenance-Mode"] = "1"
                ngx.header["Cache-Control"]       = "no-store"
                ngx.header["Retry-After"]         = "600"
                ngx.status = 503

                local fh = io.open("/opt/TaskMinder/maintenance.html", "r")
                if fh then
                    local body = fh:read("*a")
                    fh:close()
                    ngx.header["Content-Type"] = "text/html; charset=utf-8"
                    ngx.print(body)
                else
                    ngx.header["Content-Type"] = "text/plain"
                    ngx.print("Service Unavailable")
                end
                ngx.exit(ngx.HTTP_OK)
		    end
        }

        proxy_pass http://localhost:3000;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 86400; # For potential websockets (socket.io)
    }
}
