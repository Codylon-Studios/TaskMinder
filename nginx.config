#=======================================================================
# NGINX REVERSE PROXY CONFIGURATION
#=======================================================================
# HOW TO USE THIS TEMPLATE (more information: https://docs.taskminder.de):
# 1. Replace placeholder domains (e.g., taskminder.de)
#    with your own domain names.
# 2. Update SSL certificate paths to match your domain's certificates,
#    typically found in `/etc/letsencrypt/live/example.com/`.
#-----------------------------------------------------------------------
# CERTBOT (LET'S ENCRYPT) SETUP NOTES:
# - To obtain your first SSL certificate, start with only the `listen 80`
#   server block. This allows Certbot's HTTP-01 challenge to succeed.
# - After Certbot has successfully created your certificates, you can
#   enable the full HTTPS configuration below (the `listen 443 ssl` blocks).
#-----------------------------------------------------------------------
# MAINTENANCE MODE:
# - enable:  touch /etc/nginx/maintenance.flag
# - disable: rm /etc/nginx/maintenance.flag
# - lua_shared_dict must be in /etc/nginx/nginx.conf in the http-block:
#   lua_shared_dict maintenance_flag 1m;
#=======================================================================

# Block 1: Redirect all HTTP traffic to HTTPS
#-----------------------------------------------------------------------
server {
    listen 80;
    server_name taskminder.de www.taskminder.de monitoring.taskminder.de;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Block 2: Redirect www to non-www for a canonical URL (HTTPS)
#-----------------------------------------------------------------------
server {
    listen 443 ssl http2;
    server_name www.taskminder.de;

    # SSL Configuration (managed by Certbot)
    # NOTE: This certificate is for monitoring.taskminder.de but is a
    # "SAN certificate" that also covers taskminder.de and www.taskminder.de.
    ssl_certificate /etc/letsencrypt/live/monitoring.taskminder.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/monitoring.taskminder.de/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://taskminder.de$request_uri;
}

# Block 3: Main server for https://taskminder.de
#-----------------------------------------------------------------------
server {
    listen 443 ssl http2;
    server_name taskminder.de;

    # SSL Configuration (using the shared SAN certificate)
    ssl_certificate /etc/letsencrypt/live/monitoring.taskminder.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/monitoring.taskminder.de/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    server_tokens off;
    client_max_body_size 20m;

    location = /bootstrap {
        access_by_lua_block {
            local flag_cache = ngx.shared.maintenance_flag
            local is_maintenance = flag_cache:get("active")

            if is_maintenance == nil then
                local f = io.open("/etc/nginx/maintenance.flag", "r")
                is_maintenance = (f ~= nil)
                if f then f:close() end
                flag_cache:set("active", is_maintenance, 5)
            end

            if is_maintenance then
                ngx.header["X-Maintenance-Mode"] = "1"
                ngx.header["Cache-Control"]       = "no-store"
                ngx.header["Retry-After"]         = "600"
                ngx.status = 503

                local fh = io.open("/opt/TaskMinder/maintenance.html", "r")
                if fh then
                    local body = fh:read("*a")
                    fh:close()
                    ngx.header["Content-Type"] = "text/html; charset=utf-8"
                    ngx.print(body)
                else
                    ngx.header["Content-Type"] = "text/plain"
                    ngx.print("Service Unavailable")
                end
                ngx.exit(ngx.HTTP_OK)
            end
        }

        proxy_pass http://localhost:3000;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 120;
    }

    location / {
        access_by_lua_block {
            local flag_cache = ngx.shared.maintenance_flag
            local is_maintenance = flag_cache:get("active")

            if is_maintenance == nil then
                local f = io.open("/etc/nginx/maintenance.flag", "r")
                is_maintenance = (f ~= nil)
                if f then f:close() end
                flag_cache:set("active", is_maintenance, 5)
            end

            if is_maintenance then
                ngx.header["X-Maintenance-Mode"] = "1"
                ngx.header["Cache-Control"]       = "no-store"
                ngx.header["Retry-After"]         = "600"
                ngx.exit(503)
            end
        }

        proxy_pass http://localhost:3000;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 86400; # For potential websockets (socket.io)
    }
}

# Block 4: Subdomain server for https://monitoring.taskminder.de
#-----------------------------------------------------------------------
server {
    listen 443 ssl http2;
    server_name monitoring.taskminder.de;

    # SSL Configuration (using the shared SAN certificate)
    ssl_certificate /etc/letsencrypt/live/monitoring.taskminder.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/monitoring.taskminder.de/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    server_tokens off;
    client_max_body_size 20m;

    location / {
        proxy_pass http://localhost:3001;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 86400;
    }
}